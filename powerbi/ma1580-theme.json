{
  "name": "MA1580 Graduate Outcomes",
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/themes/1.0.0/schema.json",

  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#6250d6",
    "#e34948"
  ],

  "background": "#fcfcfb",
  "secondaryBackground": "#f9f9f7",
  "foreground": "#0b0b0b",
  "foregroundNeutralSecondary": "#52514e",
  "foregroundNeutralTertiary": "#898781",
  "tableAccent": "#2a78d6",

  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#f0efec",
  "minimum": "#cde2fb",

  "textClasses": {
    "title":      { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0b0b0b" },
    "header":     { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label":      { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#52514e" },
    "callout":    { "fontFace": "Segoe UI",          "fontSize": 32, "color": "#0b0b0b" },
    "largeTitle": { "fontFace": "Segoe UI Semibold", "fontSize": 18, "color": "#0b0b0b" }
  },

  "visualStyles": {
    "*": {
      "*": {
        "background":  [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border":      [{ "show": false }],
        "visualHeader":[{ "show": true, "background": { "solid": { "color": "#fcfcfb" } }, "transparency": 100 }],
        "dropShadow":  [{ "show": false }],

        "title": [{
          "show": true,
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 12,
          "fontColor": { "solid": { "color": "#0b0b0b" } },
          "background": { "solid": { "color": "#fcfcfb" } },
          "alignment": "left"
        }],

        "categoryAxis": [{
          "show": true,
          "showAxisTitle": true,
          "labelColor":  { "solid": { "color": "#898781" } },
          "fontSize": 9,
          "gridlineShow": false,
          "lineColor":   { "solid": { "color": "#c3c2b7" } }
        }],

        "valueAxis": [{
          "show": true,
          "showAxisTitle": true,
          "labelColor":   { "solid": { "color": "#898781" } },
          "fontSize": 9,
          "gridlineShow": true,
          "gridlineColor":{ "solid": { "color": "#e1e0d9" } },
          "gridlineThickness": 1,
          "gridlineStyle": "solid"
        }],

        "legend": [{
          "show": true,
          "position": "Top",
          "showTitle": false,
          "labelColor": { "solid": { "color": "#52514e" } },
          "fontSize": 9
        }],

        "labels": [{
          "show": false,
          "color": { "solid": { "color": "#52514e" } },
          "fontSize": 9,
          "labelDisplayUnits": 0
        }]
      }
    },

    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": true, "markerSize": 4, "lineStyle": "solid" }]
      }
    },

    "columnChart":  { "*": { "labels": [{ "show": false }] } },
    "barChart":     { "*": { "categoryAxis": [{ "gridlineShow": false }] } },

    "scatterChart": {
      "*": {
        "fillPoint": [{ "show": true }],
        "categoryLabels": [{ "show": true, "color": { "solid": { "color": "#52514e" } }, "fontSize": 9 }]
      }
    },

    "card": {
      "*": {
        "labels":         [{ "fontFamily": "Segoe UI", "fontSize": 28, "color": { "solid": { "color": "#0b0b0b" } } }],
        "categoryLabels": [{ "show": true, "fontSize": 9, "color": { "solid": { "color": "#898781" } } }]
      }
    },

    "pivotTable": {
      "*": {
        "grid":          [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#e1e0d9" } }, "rowPadding": 3 }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "backColor": { "solid": { "color": "#f9f9f7" } }, "fontSize": 9 }],
        "values":        [{ "fontColorPrimary": { "solid": { "color": "#0b0b0b" } }, "backColorPrimary": { "solid": { "color": "#fcfcfb" } }, "fontSize": 9 }]
      }
    },

    "slicer": {
      "*": {
        "header": [{ "show": true, "fontColor": { "solid": { "color": "#52514e" } }, "fontSize": 9, "background": { "solid": { "color": "#fcfcfb" } } }],
        "items":  [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "background": { "solid": { "color": "#fcfcfb" } }, "fontSize": 9 }]
      }
    },

    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }],
        "outspace":   [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }]
      }
    }
  }
}
